install.packages("data.table")
install.packages("HardyWeinberg")
library(data.table)
library(HardyWeinberg)
data <- fread("TSIChr22v4.raw")
geno <- data[, 7:ncol(data), with = FALSE]
n_variants <- ncol(geno)
n_variants
n_missing <- sum(is.na(as.matrix(geno)))
n_total <- nrow(geno) * ncol(geno)
missing_percentage <- 100 * n_missing / n_total
missing_percentage
View(geno)
View(geno)
missing_percentage
is_monomorphic <- sapply(geno, function(x) {
x <- x[!is.na(x)]
length(x) > 0 && length(unique(x)) == 1
})
n_monomorphic <- sum(is_monomorphic)
n_monomorphic
percentage_monomorphic <- 100 * n_monomorphic / n_variants
percentage_monomorphic
geno_poly <- geno[, !is_monomorphic, with = FALSE]
n_poly <- ncol(geno_poly)
n_poly
grep("rs587756191", names(geno_poly), value = TRUE)
snp_name <- grep("rs587756191_T", names(geno_poly), value = TRUE)[1]
snp_name
snp <- geno_poly[[snp_name]]
counts <- table(factor(snp, levels = 0:2))
counts
hw_chisq_cc <- HWChisq(
as.numeric(counts),
cc = 0.5,
verbose = TRUE
)
hw_chisq_no_cc <- HWChisq(
as.numeric(counts),
cc = 0,
verbose = TRUE
)
hw_exact <- HWExact(
as.numeric(counts),
verbose = TRUE
)
hw_exact
set.seed(123)
hw_perm <- HWPerm(
as.numeric(counts),
nperm = 10000,
verbose = TRUE
)
hw_perm
geno_counts <- t(sapply(geno_poly, function(x) {
table(factor(x, levels = 0:2))
}))
colnames(geno_counts) <- c("AA", "AB", "BB")
dim(geno_counts)
head(geno_counts)
pvalues <- HWExactStats(
geno_counts,
x.linked = FALSE
)
results <- data.frame(
SNP = rownames(geno_counts),
AA = geno_counts[, "AA"],
AB = geno_counts[, "AB"],
BB = geno_counts[, "BB"],
pvalue = pvalues
)
alpha <- 0.05
n_significant <- sum(results$pvalue < alpha)
percentage_significant <- 100 * n_significant / nrow(results)
n_significant
percentage_significant
most_significant <- which.min(results$pvalue)
results[most_significant, ]
results$SNP[most_significant]
min(results$pvalue)
x <- as.numeric(geno_counts[most_significant, ])
n <- sum(x)
p <- (2*x[1] + x[2]) / (2*n)
q <- 1 - p
expected_freq <- c(
AA = p^2,
AB = 2*p*q,
BB = q^2
)
expected_counts <- n * expected_freq
expected_counts
observed <- x
data.frame(
Genotype = c("AA", "AB", "BB"),
Observed = observed,
Expected = expected_counts
)
f_values <- apply(
geno_counts,
1,
function(x) HWf(x, verbose = FALSE)
)
f_values <- apply(
geno_counts,
1,
function(x) HWf(x)
)
head(f_values)
length(f_values)
summary(f_values)
sd(f_values)
hist(
f_values,
breaks = 50,
main = "Distribution of the inbreeding coefficient",
xlab = "Inbreeding coefficient (f)",
ylab = "Number of SNPs",
col = "lightblue",
border = "white"
)
qqnorm(
f_values,
main = "Normal Q-Q Plot of the Inbreeding Coefficient",
xlab = "Theoretical normal quantiles",
ylab = "Observed f quantiles"
)
qqline(
f_values,
col = "red",
lwd = 2
)
alphas <- c(0.10, 0.05, 0.01, 0.001)
summary_alpha <- data.frame(
alpha = alphas,
significant = sapply(
alphas,
function(a) sum(pvalues < a)
)
)
summary_alpha$percentage <- 100 *
summary_alpha$significant /
length(pvalues)
summary_alpha
