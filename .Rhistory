install.packages(c("data.table", "HardyWeinberg"))
library(data.table)
library(HardyWeinberg)
data <- fread("TSIChr22v4.raw")
dim(data)
names(data)[1:10]
head(data[, 1:10])
geno <- data[, 7:ncol(data), with = FALSE]
dim(geno)
# Número total de variantes
n_variants <- ncol(geno)
# Número total de genotipos
n_total <- nrow(geno) * ncol(geno)
# Número total de valores missing
n_missing <- sum(is.na(geno))
# Porcentaje de datos missing
pct_missing <- 100 * n_missing / n_total
n_variants
n_missing
pct_missing
# Número de valores distintos por SNP, ignorando NA
n_unique <- sapply(geno, function(x) length(unique(na.omit(x))))
# SNPs monomórficos
monomorphic <- n_unique == 1
# Número y porcentaje de monomórficos
n_monomorphic <- sum(monomorphic)
pct_monomorphic <- 100 * n_monomorphic / n_variants
n_monomorphic
pct_monomorphic
geno_poly <- geno[, !monomorphic, with = FALSE]
dim(geno_poly)
"rs587756191_T" %in% names(geno_poly)
which(names(geno_poly) == "rs587756191_T")
dim(geno)
n_variants
n_missing
pct_missing
n_monomorphic
pct_monomorphic
dim(geno_poly)
"rs587756191_T" %in% names(geno_poly)
which(names(geno_poly) == "rs587756191_T")
snp <- geno_poly[["rs587756191_T"]]
table(snp, useNA = "ifany")
geno_counts <- table(factor(snp, levels = c(0, 1, 2)))
geno_counts
HWChisq(geno_counts, cc = FALSE)
counts <- as.numeric(geno_counts)
HWChisq(counts, cc = FALSE)
HWChisq(counts, cc = TRUE)
HWExact(counts)
set.seed(123)
HWPerm(counts)
geno_counts_all <- t(sapply(geno_poly, function(x) {
table(factor(x, levels = c(0, 1, 2)))
}))
colnames(geno_counts_all) <- c("AA", "AB", "BB")
dim(geno_counts_all)
head(geno_counts_all)
rownames(geno_counts_all)[1:10]
geno_counts_all["rs587756191_T", ]
dim(geno_counts_all)
head(geno_counts_all)
geno_counts_all["rs587756191_T", ]
exact_results <- HWExactStats(geno_counts_all)
head(exact_results)
dim(exact_results)
colnames(exact_results)
str(exact_results)
head(exact_results)
dim(exact_results)
colnames(exact_results)
str(exact_results)
# Número de SNPs significativos con alpha = 0.05
n_sig_005 <- sum(exact_results < 0.05)
# Porcentaje de SNPs significativos
pct_sig_005 <- 100 * n_sig_005 / length(exact_results)
# Número esperado por azar
expected_005 <- 0.05 * length(exact_results)
n_sig_005
pct_sig_005
expected_005
min_p <- min(exact_results)
min_p
which.min(exact_results)
names(exact_results) <- rownames(geno_counts_all)
most_significant <- names(exact_results)[which.min(exact_results)]
most_significant
exact_results[most_significant]
geno_counts_all[most_significant, ]
n_sig_005
pct_sig_005
expected_005
min_p
most_significant
exact_results[most_significant]
geno_counts_all[most_significant, ]
f_values <- apply(geno_counts_all, 1, function(x) {
HWf(x)
})
head(f_values)
length(f_values)
summary(f_values)
mean_f <- mean(f_values, na.rm = TRUE)
sd_f <- sd(f_values, na.rm = TRUE)
min_f <- min(f_values, na.rm = TRUE)
max_f <- max(f_values, na.rm = TRUE)
median_f <- median(f_values, na.rm = TRUE)
mean_f
sd_f
min_f
max_f
median_f
sum(is.na(f_values))
hist(
f_values,
breaks = 50,
main = "Distribution of the inbreeding coefficient (f)",
xlab = "Inbreeding coefficient (f)",
ylab = "Frequency",
col = "lightblue",
border = "white"
)
qqnorm(
f_values,
main = "Normal Q-Q plot of the inbreeding coefficient"
)
qqline(
f_values,
col = "red",
lwd = 2
)
head(f_values)
length(f_values)
summary(f_values)
mean_f
sd_f
min_f
max_f
median_f
sum(is.na(f_values))
alphas <- c(0.10, 0.05, 0.01, 0.001)
n_significant <- sapply(alphas, function(a) {
sum(exact_results < a)
})
pct_significant <- 100 * n_significant / length(exact_results)
results_q8 <- data.frame(
alpha = alphas,
significant_SNPs = n_significant,
percentage = pct_significant
)
results_q8$expected_by_chance <- alphas * length(exact_results)
results_q8
hist(
f_values,
breaks = 50,
main = "Distribution of the inbreeding coefficient (f)",
xlab = "Inbreeding coefficient (f)",
ylab = "Frequency",
col = "lightblue",
border = "white"
)
